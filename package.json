{
  "name": "Github-Pages-Home",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "npx rimraf dist coverage .eslintcache",
    "audit": "npm audit --audit-level=high --omit=dev",
    "prepare": "husky",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \".\"",
    "format:check": "prettier --check \".\"",
    "deps:check": "npm outdated",
    "size": "size-limit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:spell && npm run lint:secrets",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint . --max-warnings 0",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:html": "html-validate \"*.html\"",
    "lint:spell": "cspell \"**\"",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:commit": "commitlint --edit",
    "snapshots:renew": "npx playwright test --update-snapshots",
    "verify": "npm run format:check && npm run lint && npm run size && npm run test:coverage && npm run audit && npm run build && npm run test:e2e"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "cspell": "^10.3.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.12.0",
    "html-validate": "^11.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "secretlint": "^13.0.5",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
